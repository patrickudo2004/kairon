{
  "name": "kairon",
  "private": true,
  "version": "1.0.0",
  "description": "Broadcast Stage & Rundown Engine for Live Events and Ministry",
  "author": "Patrick Udo <patrickudo2004@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/patrickudo2004/kairon.git"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k -s first \"npm run dev\" \"wait-on tcp:3000 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@auth/core": "^0.37.4",
    "@convex-dev/auth": "^0.0.90",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^1.30.0",
    "@react-pdf/renderer": "^4.3.2",
    "@tanstack/react-query": "^5.90.12",
    "convex": "^1.32.0",
    "dotenv": "^17.3.1",
    "lucide-react": "^0.554.0",
    "lz-string": "^1.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-qr-code": "^2.0.15",
    "react-router-dom": "^7.9.6",
    "recharts": "^3.4.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^22.19.11",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "app.kairon.desktop",
    "productName": "Kairon",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "patrickudo2004",
      "repo": "kairon"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "category": "public.app-category.video"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Patrick Udo <patrickudo2004@users.noreply.github.com>",
      "desktopName": "Kairon",
      "syncDesktopName": true,
      "category": "AudioVideo"
    }
  }
}
